FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/docker-dev-entrypoint.sh /usr/local/bin/docker-dev-entrypoint
RUN npm ci \
  && sha256sum package-lock.json | cut -d ' ' -f 1 > node_modules/.package-lock.sha256 \
  && chmod +x /usr/local/bin/docker-dev-entrypoint
EXPOSE 5173 3001
CMD ["docker-dev-entrypoint"]
