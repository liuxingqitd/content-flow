{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContentFlow",
  "version": "0.0.0",
  "identifier": "com.contentflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build && npm run package:server",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ContentFlow",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/contentflow-api"
    ]
  }
}
